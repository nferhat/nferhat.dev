
{% if blog.draft -%}
<pre class=draft-text>
    This page is still a draft!
</pre>
{% endif -%}

{% render 'partials/blog/metadata', blog: blog %}
<h1 class="blog-title{% if page.draft %} draft{% endif %}">{{blog.title}}</h1>

{{blog.contents}}

<script defer src="/static/footnotes.js"></script>
<script defer src="/static/progress-bar.js"></script>

{% if blog.meta.has_math == true -%}
    <!-- Djot emits math as raw LaTeX inside span.math, convert it to MathML (Temml) -->
    <script src="/static/temml/temml.min.js"></script>
    <script src="/static/temml/render-math.js"></script>
{% endif -%}
