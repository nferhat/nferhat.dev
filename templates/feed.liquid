<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>nferhat's blog</title>
    <subtitle>Where pondering and random thoughts mix together in harmony</subtitle>
    <id>{{ site.base_url }}/</id>
    <link href="{{ site.base_url }}/feed.xml" rel="self" />
    <link href="{{ site.base_url }}/blog/index.html" />
    <author><name>nferhat</name></author>
    {% assign newest = pages | first -%}
    {% if newest.release_date != nil -%}
        <updated>{{ newest.release_date.year }}-{{ newest.release_date.month | prepend: '0' | slice: -2, 2 }}-{{ newest.release_date.day | prepend: '0' | slice: -2, 2 }}T00:00:00Z</updated>
    {% endif -%}

    {% assign abs_src = 'src="' | append: site.base_url | append: '/' -%}
    {% assign abs_href = 'href="' | append: site.base_url | append: '/' -%}
    {% for blog in pages -%}
        {% if blog.url contains "blog/" and blog.url != "blog/index.html" and blog.url != "blog/tags.html" and blog.draft == false -%}
            <entry>
                <title>{{ blog.title | strip_html | escape }}</title>
                <id>{{ site.base_url }}/{{ blog.url }}</id>
                <link href="{{ site.base_url }}/{{ blog.url }}" />
                <updated>{{ blog.release_date.year }}-{{ blog.release_date.month | prepend: '0' | slice: -2, 2 }}-{{ blog.release_date.day | prepend: '0' | slice: -2, 2 }}T00:00:00Z</updated>
                {% if blog.description != nil -%}
                    <summary>{{ blog.description | escape }}</summary>
                {% endif -%}
                {% for tag in blog.tags -%}
                    <category term="{{ tag | escape }}" />
                {% endfor -%}
            </entry>
        {% endif -%}
    {% endfor -%}
</feed>
